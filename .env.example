# Environment Variables
NODE_ENV=development
PORT=3000

# Local development database. For production, use a managed MongoDB URI.
MONGODB_URI=mongodb://localhost:27017/farmers_app

# Generate a unique random secret of at least 32 characters for each environment.
JWT_SECRET=
JWT_EXPIRE=7d

# Only set this when a separate trusted frontend origin must call the API.
# CORS_ORIGINS=https://your-domain.example

# Weather integration
OPENWEATHER_API_KEY=
# Legacy alias accepted by the weather routes; prefer OPENWEATHER_API_KEY.
# WEATHER_API_KEY=

# Production password-reset email and canonical public URL
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-gmail-app-password
# CLIENT_URL=https://your-public-domain.example

# Product image storage directory; use persistent storage in production.
UPLOAD_DIR=./public/uploads/products
MAX_FILE_SIZE=5242880

# Optional payment webhook verification secret
# PAYMENT_WEBHOOK_SECRET=

# Required only when an external scheduler calls the weather alert endpoint
# WEATHER_ALERTS_CRON_SECRET=
